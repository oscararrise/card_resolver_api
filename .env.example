DATABASE_URL=postgresql+psycopg://card_resolver:CHANGE_ME@127.0.0.1:5432/card_resolver
SERVICE_TOKEN=SET_A_LONG_RANDOM_SERVER_SIDE_TOKEN
ADMIN_USER=card_admin
ADMIN_PASSWORD=SET_A_LONG_RANDOM_ADMIN_PASSWORD
MAX_UPLOAD_BYTES=5242880

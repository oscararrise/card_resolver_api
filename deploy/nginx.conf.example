# Include these locations INSIDE the existing Appearance HTTPS 443 server block.
# The trailing slash on proxy_pass removes /card-resolver/ before FastAPI routes.
# Do not put them in the port 80 redirect server block.

location = /card-resolver {
    return 308 /card-resolver/admin;
}

location ^~ /card-resolver/ {
    client_max_body_size 6m;
    limit_req zone=card_resolver_limit burst=20 nodelay;
    proxy_pass http://127.0.0.1:8010/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 45s;
    add_header Cache-Control "no-store" always;
}

# Define once in the Nginx `http` context, for example in a separate
# /etc/nginx/conf.d/card-resolver-limit.conf:
# limit_req_zone $binary_remote_addr zone=card_resolver_limit:10m rate=10r/s;

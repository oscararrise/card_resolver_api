# Add within an existing TLS server block on port 443. Configure its certificate
# and network restrictions under the VM's established ingress policy.
client_max_body_size 6m;
proxy_hide_header server;

location /api/v1/cards/ {
    limit_req zone=card_api burst=20 nodelay;
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 15s;
}
location /admin {
    limit_req zone=card_admin burst=5 nodelay;
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-store" always;
    proxy_read_timeout 45s;
}
location = /health {
    proxy_pass http://127.0.0.1:8010;
}
# Define zones once in the http context (outside server):
# limit_req_zone $binary_remote_addr zone=card_api:10m rate=10r/s;
# limit_req_zone $binary_remote_addr zone=card_admin:10m rate=10r/m;
